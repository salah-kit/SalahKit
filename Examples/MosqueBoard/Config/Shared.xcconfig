// Settings shared by every target. Signing is per developer: copy
// Local.xcconfig.example to Local.xcconfig (gitignored) and set your team there.

CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

// The example's identity: the bundle identifier of the iPad app and of the Apple TV app, one
// for both, which the test bundles' follow. Apple registers an identifier to one team, so to
// sign with another, name your own in Local.xcconfig.
APP_BUNDLE_IDENTIFIER = com.omarkhaled.salah.examples.MosqueBoard

#include? "Local.xcconfig"
