// Settings shared by every target. Signing is per developer: copy
// Local.xcconfig.example to Local.xcconfig (gitignored) and set your team there.

CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

// The example's identity. Every target's bundle identifier follows the app's, and the app
// shares the App Group with its widget extension; the entitlements and the Info.plist key the
// code reads take the group from here. Apple registers an identifier to one team, so to sign
// with another, name your own in Local.xcconfig.
APP_BUNDLE_IDENTIFIER = io.github.salah-kit.PhoneWidgets
APP_GROUP_IDENTIFIER = group.io.github.salah-kit.PhoneWidgets.shared

#include? "Local.xcconfig"
