    "A method sets the Fajr, Maghrib and Isha rules, the night, its own minutes and the rounding. Changing any of them switches to Custom.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تحدد الطريقة قواعد الفجر والمغرب والعشاء والليل ودقائقها والتقريب. تغيير أي منها ينقلك إلى طريقة مخصصة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A method sets the Fajr, Maghrib and Isha rules, the night, its own minutes and the rounding. Changing any of them switches to Custom."
          }
        }
      }
    },
    "Added on top of the method's own minutes.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تضاف فوق دقائق الطريقة نفسها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added on top of the method's own minutes."
          }
        }
      }
    },
