    "Alerts are off. Turn them on in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "التنبيهات متوقفة. شغّلها من الإعدادات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts are off. Turn them on in Settings."
          }
        }
      }
    },
    "Alerts are scheduled as notifications for the next 14 days, within iOS's limit on pending notifications, and the app schedules them again whenever it opens.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُجدوَل التنبيهات إشعاراتٍ للأيام الأربعة عشر القادمة ضمن حدّ iOS للإشعارات المعلّقة، ويعيد التطبيق جدولتها كلما فُتح."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts are scheduled as notifications for the next 14 days, within iOS's limit on pending notifications, and the app schedules them again whenever it opens."
          }
        }
      }
    },
