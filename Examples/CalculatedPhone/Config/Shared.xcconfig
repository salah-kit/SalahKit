// Settings shared by every target. Signing is per developer: copy
// Local.xcconfig.example to Local.xcconfig (gitignored) and set your team there.

CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

// The example's identity: the app's bundle identifier, which the test bundles' follow. Apple
// registers an identifier to one team, so to sign with another, name your own in
// Local.xcconfig.
APP_BUNDLE_IDENTIFIER = io.github.salah-kit.CalculatedPhone

#include? "Local.xcconfig"
