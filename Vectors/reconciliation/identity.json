    {
      "id": "reconciliation.identity.moved-reminder-keeps-its-identifier",
      "description": "Dhuhr's before-reminder moves from 10 to 15 minutes (12:09 to 12:04). Its identifier has no time in it, so the request is replaced by one add and never removed; the confirmed occurrence carries the new fire date.",
      "provenance": "RFC 0003 §4.2, §4.5 step 4 and 6. Corrects Salah's characterization tests characterizesAMovedAlertIsRemovedBeforeItsReplacementIsAdded and characterizesIdentifiersCarryTheFireTimestamp (salah-kit/Salah at a0206dd), as RFC 0003 §6 records.",
      "input": {
        "scheduler": {
          "identifierPrefix": "salah.",
          "namespace": "prayers",
          "threadIdentifier": "prayers",
          "deliveredRetention": 172800
        },
        "center": {},
        "steps": [
          {
            "apply": {
              "namespace": "prayers",
              "coveredUntil": "2026-06-04T00:00:00+03:00",
              "alerts": [
                {
                  "id": "2026-06-02/dhuhr/before",
                  "fireDate": "2026-06-02T12:09:00+03:00"
                }
              ]
            },
            "now": "2026-06-02T06:00:00+03:00"
          },
          {
            "apply": {
              "namespace": "prayers",
              "coveredUntil": "2026-06-04T00:00:00+03:00",
              "alerts": [
                {
                  "id": "2026-06-02/dhuhr/before",
                  "fireDate": "2026-06-02T12:04:00+03:00"
                }
              ]
            },
            "now": "2026-06-02T06:00:00+03:00"
          }
        ]
      },
      "expected": {
