{
  "schemaVersion": 1,
  "description": "Plan validation (RFC 0003 §4.5): a foreign plan or alert, including an empty plan, and a repeated identity are rejected before any call.",
  "vectors": [
    {
      "id": "reconciliation.namespaces.foreign-plan",
      "description": "A plan of another namespace is rejected before any call.",
      "provenance": "RFC 0003 §4.5 Validation: the plan's namespace is checked before any call to the center.",
      "input": {
        "scheduler": {
          "identifierPrefix": "salah.",
          "namespace": "prayers",
          "threadIdentifier": "prayers",
          "deliveredRetention": 172800
        },
        "center": {
          "pending": [
            {
              "id": "salah.prayers/2026-06-02/isha/atTime",
              "fireDate": "2026-06-02T20:30:00+03:00",
              "title": "isha",
              "body": "v1 atTime",
              "thread": "prayers"
            }
          ]
        },
        "steps": [
          {
            "apply": {
              "namespace": "mosque",
              "coveredUntil": "2026-06-04T00:00:00+03:00",
              "alerts": [
                {
                  "id": "2026-06-02/asr/atTime",
                  "fireDate": "2026-06-02T15:35:00+03:00"
                }
              ]
            },
            "now": "2026-06-02T06:00:00+03:00"
          }
        ]
      },
      "expected": {
        "reports": [
          {
            "error": "namespaceMismatch"
          }
        ],
        "pending": [
          {
            "id": "salah.prayers/2026-06-02/isha/atTime",
            "fireDate": "2026-06-02T20:30:00+03:00",
            "title": "isha",
            "body": "v1 atTime",
            "thread": "prayers"
          }
        ],
        "delivered": [],
        "calls": []
      }
    },
