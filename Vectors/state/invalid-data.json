{
  "schemaVersion": 1,
  "description": "Rows that make their day unavailable(invalidData), and iqama that is discarded without invalidating the day.",
  "vectors": [
    {
      "id": "state.invalid.chronology-within-day",
      "description": "Asr published before Dhuhr: the day is invalid, never reordered.",
      "provenance": "RFC 0001 §4.3 rule 5, §4.4 step 5",
      "input": {
        "location": {"latitude": 55.95, "longitude": -3.19, "timeZone": "Europe/London"},
        "source": {
          "expectedKinds": ["fajr", "sunrise", "dhuhr", "asr", "maghrib", "isha"],
          "rows": [
            {"day": "2026-10-15", "times": {"fajr": "05:29", "sunrise": "07:22", "dhuhr": "12:52", "asr": "12:40", "maghrib": "18:10", "isha": "19:43"}}
          ]
        },
        "query": {"type": "day", "day": "2026-10-15"}
      },
      "expected": {"availability": "unavailable", "reason": "invalidData"}
    },
    {
      "id": "state.invalid.equal-instants-within-day",
      "description": "Maghrib and Isha at the same instant: times must strictly increase.",
      "provenance": "RFC 0001 §4.3 rule 5 ('strictly increase')",
      "input": {
        "location": {"latitude": 55.95, "longitude": -3.19, "timeZone": "Europe/London"},
