          "expectedKinds": ["fajr", "sunrise", "dhuhr", "asr", "maghrib", "isha"],
          "rows": [
            {"day": "2026-10-14", "times": {"fajr": "05:27", "sunrise": "07:20", "dhuhr": "12:53", "asr": "15:41", "maghrib": "18:12", "isha": "19:45"}},
            {"day": "2026-10-15", "times": {"fajr": "05:29", "sunrise": "07:22", "dhuhr": "12:52", "asr": "15:39", "maghrib": "18:10", "isha": "19:43"}},
            {"day": "2026-10-15", "times": {"fajr": "05:29", "sunrise": "07:22", "dhuhr": "12:52", "asr": "15:39", "maghrib": "18:10", "isha": "19:43"}}
          ]
        },
        "query": {"type": "day", "day": "2026-10-15"}
      },
      "expected": {"availability": "unavailable", "reason": "invalidData"}
    },
    {
      "id": "state.invalid.duplicate-rows.other-day-unaffected",
      "description": "A bad row affects only its own day: 2026-10-14 in the same table is complete.",
      "provenance": "RFC 0001 §4.4 ('a bad row affects only its own day')",
      "input": {
        "location": {"latitude": 55.95, "longitude": -3.19, "timeZone": "Europe/London"},
        "source": {
          "expectedKinds": ["fajr", "sunrise", "dhuhr", "asr", "maghrib", "isha"],
          "rows": [
            {"day": "2026-10-14", "times": {"fajr": "05:27", "sunrise": "07:20", "dhuhr": "12:53", "asr": "15:41", "maghrib": "18:12", "isha": "19:45"}},
