            {"day": "2026-10-15", "times": {"fajr": "05:29", "sunrise": "07:22", "dhuhr": "12:52", "asr": "15:39", "maghrib": "18:10", "isha": "19:43"}}
          ]
        },
        "query": {"type": "day", "day": "2026-10-14"}
      },
      "expected": {
        "availability": "available",
        "coverage": "complete",
        "isFriday": false,
        "events": [
          {"day": "2026-10-14", "kind": "fajr", "time": "2026-10-14T05:27:00+01:00", "iqama": null, "observance": "ordinary"},
          {"day": "2026-10-14", "kind": "sunrise", "time": "2026-10-14T07:20:00+01:00", "iqama": null, "observance": "ordinary"},
          {"day": "2026-10-14", "kind": "dhuhr", "time": "2026-10-14T12:53:00+01:00", "iqama": null, "observance": "ordinary"},
          {"day": "2026-10-14", "kind": "asr", "time": "2026-10-14T15:41:00+01:00", "iqama": null, "observance": "ordinary"},
          {"day": "2026-10-14", "kind": "maghrib", "time": "2026-10-14T18:12:00+01:00", "iqama": null, "observance": "ordinary"},
          {"day": "2026-10-14", "kind": "isha", "time": "2026-10-14T19:45:00+01:00", "iqama": null, "observance": "ordinary"}
        ]
      }
