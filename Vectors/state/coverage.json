        "query": {"type": "day", "day": "2026-12-12"}
      },
      "expected": {
        "availability": "available",
        "coverage": {"partial": {"isha": "noPublishedData"}},
        "isFriday": false,
        "events": [
          {"day": "2026-12-12", "kind": "fajr", "time": "2026-12-12T05:40:00+08:00", "iqama": null, "observance": "ordinary"},
          {"day": "2026-12-12", "kind": "sunrise", "time": "2026-12-12T07:02:00+08:00", "iqama": null, "observance": "ordinary"},
