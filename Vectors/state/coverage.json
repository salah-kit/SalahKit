          {"day": "2026-12-01", "kind": "isha", "time": "2026-12-01T20:20:00+08:00", "iqama": null, "observance": "ordinary"}
        ]
      }
    },
    {
      "id": "state.coverage.day.partial-missing-kind",
      "description": "A row without Isha is available and partial, Isha missing with reason noPublishedData; its other times are listed.",
