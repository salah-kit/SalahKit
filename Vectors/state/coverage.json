        },
        "query": {"type": "day", "day": "2026-12-01"}
      },
      "expected": {
        "availability": "available",
        "coverage": "complete",
        "isFriday": false,
        "events": [
          {"day": "2026-12-01", "kind": "fajr", "time": "2026-12-01T05:40:00+08:00", "iqama": null, "observance": "ordinary"},
