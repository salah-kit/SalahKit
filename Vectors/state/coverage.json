          {"day": "2026-12-12", "kind": "maghrib", "time": "2026-12-12T19:06:00+08:00", "iqama": null, "observance": "ordinary"}
        ]
      }
    },
    {
      "id": "state.coverage.day.partial-mixed-reasons",
      "description": "A spring-forward row with a rejected nonexistent Fajr and no Asr is partial with a reason per kind.",
