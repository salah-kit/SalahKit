        "query": {"type": "day", "day": "2026-03-08"}
      },
      "expected": {
        "availability": "available",
        "coverage": {"partial": {"fajr": "unresolvedWallTime", "asr": "noPublishedData"}},
        "isFriday": false,
        "events": [
          {"day": "2026-03-08", "kind": "sunrise", "time": "2026-03-08T07:20:00-04:00", "iqama": null, "observance": "ordinary"},
          {"day": "2026-03-08", "kind": "dhuhr", "time": "2026-03-08T13:08:00-04:00", "iqama": null, "observance": "ordinary"},
