{
  "schemaVersion": 1,
  "description": "Query limits: an end before the start, and the 400-civil-day clamp.",
  "vectors": [
    {
      "id": "state.limits.events.end-before-start",
      "description": "An end before the start counts as equal to it: the request is the zero-length [13:04, 13:04], which lists the event at exactly 13:04 and has one zero-length known interval.",
      "provenance": "RFC 0001 §4.10 'An end before the start counts as equal to the start'; §4.6 coverage, events(from:through:)",
      "input": {
        "location": {"latitude": 1.35, "longitude": 103.82, "timeZone": "Asia/Singapore"},
        "source": {
          "expectedKinds": ["fajr", "sunrise", "dhuhr", "asr", "maghrib", "isha"],
          "rows": [
            {"day": "2026-10-12", "times": {"fajr": "05:40", "sunrise": "07:02", "dhuhr": "13:04", "asr": "16:27", "maghrib": "19:06", "isha": "20:20"}},
            {"day": "2026-10-13", "times": {"fajr": "05:40", "sunrise": "07:02", "dhuhr": "13:04", "asr": "16:27", "maghrib": "19:06", "isha": "20:20"}},
            {"day": "2026-10-14", "times": {"fajr": "05:40", "sunrise": "07:02", "dhuhr": "13:04", "asr": "16:27", "maghrib": "19:06", "isha": "20:20"}},
            {"day": "2026-10-15", "times": {"fajr": "05:40", "sunrise": "07:02", "dhuhr": "13:04", "asr": "16:27", "maghrib": "19:06", "isha": "20:20"}},
            {"day": "2026-10-16", "times": {"fajr": "05:40", "sunrise": "07:02", "dhuhr": "13:04", "asr": "16:27", "maghrib": "19:06", "isha": "20:20"}}
          ]
        },
        "query": {"type": "events", "from": "2026-10-14T13:04:00+08:00", "through": "2026-10-14T12:04:00+08:00"}
      },
      "expected": {
        "events": [
          {"day": "2026-10-14", "kind": "dhuhr", "time": "2026-10-14T13:04:00+08:00", "iqama": null, "observance": "ordinary"}
        ],
        "coverage": {
          "requested": ["2026-10-14T13:04:00+08:00", "2026-10-14T13:04:00+08:00"],
          "known": [["2026-10-14T13:04:00+08:00", "2026-10-14T13:04:00+08:00"]],
          "gaps": []
        }
      }
    },
    {
      "id": "state.limits.state.end-before-start",
      "description": "state(at: 13:04, through: 12:00) uses the bound 13:04: nothing can be next in (t, t], and changesAt is null.",
      "provenance": "RFC 0001 §4.10; §4.7 next, changesAt",
      "input": {
        "location": {"latitude": 1.35, "longitude": 103.82, "timeZone": "Asia/Singapore"},
        "source": {
          "expectedKinds": ["fajr", "sunrise", "dhuhr", "asr", "maghrib", "isha"],
          "rows": [
            {"day": "2026-10-12", "times": {"fajr": "05:40", "sunrise": "07:02", "dhuhr": "13:04", "asr": "16:27", "maghrib": "19:06", "isha": "20:20"}},
            {"day": "2026-10-13", "times": {"fajr": "05:40", "sunrise": "07:02", "dhuhr": "13:04", "asr": "16:27", "maghrib": "19:06", "isha": "20:20"}},
            {"day": "2026-10-14", "times": {"fajr": "05:40", "sunrise": "07:02", "dhuhr": "13:04", "asr": "16:27", "maghrib": "19:06", "isha": "20:20"}},
