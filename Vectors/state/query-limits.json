      "expected": {
        "availability": "available",
        "previous": {"day": "2026-10-14", "kind": "dhuhr", "time": "2026-10-14T13:04:00+08:00", "iqama": null, "observance": "ordinary"},
        "latestPrayer": {"day": "2026-10-14", "kind": "dhuhr", "time": "2026-10-14T13:04:00+08:00", "iqama": null, "observance": "ordinary"},
        "next": null,
        "nextPrayer": null,
        "justStarted": {"day": "2026-10-14", "kind": "dhuhr", "time": "2026-10-14T13:04:00+08:00", "iqama": null, "observance": "ordinary"},
