          "requested": ["2026-10-14T13:04:00+08:00", "2026-10-14T13:04:00+08:00"],
          "known": [["2026-10-14T13:04:00+08:00", "2026-10-14T13:04:00+08:00"]],
          "gaps": []
        }
      }
    },
    {
      "id": "state.limits.events.clamped-to-400-days",
      "description": "A request from 2026-01-01 12:00 to 2027-06-01 is clamped to start(2026-01-01 + 400) = 2027-02-05 00:00: 2027-02-04's events are listed, 2027-02-05's and 2027-03-01's aren't. Only coverage.requested is checked.",
      "provenance": "RFC 0001 §4.10 'One query covers at most maximumQueryDays (400) civil days'",
      "input": {
        "location": {"latitude": 1.35, "longitude": 103.82, "timeZone": "Asia/Singapore"},
        "source": {
          "expectedKinds": ["fajr", "sunrise", "dhuhr", "asr", "maghrib", "isha"],
          "rows": [
            {"day": "2026-01-01", "times": {"fajr": "05:40", "sunrise": "07:02", "dhuhr": "13:04", "asr": "16:27", "maghrib": "19:06", "isha": "20:20"}},
            {"day": "2027-02-04", "times": {"fajr": "05:40", "sunrise": "07:02", "dhuhr": "13:04", "asr": "16:27", "maghrib": "19:06", "isha": "20:20"}},
            {"day": "2027-02-05", "times": {"fajr": "05:40", "sunrise": "07:02", "dhuhr": "13:04", "asr": "16:27", "maghrib": "19:06", "isha": "20:20"}},
            {"day": "2027-03-01", "times": {"fajr": "05:40", "sunrise": "07:02", "dhuhr": "13:04", "asr": "16:27", "maghrib": "19:06", "isha": "20:20"}}
          ]
        },
        "query": {"type": "events", "from": "2026-01-01T12:00:00+08:00", "through": "2027-06-01T00:00:00+08:00"}
      },
      "expected": {
        "events": [
          {"day": "2026-01-01", "kind": "dhuhr", "time": "2026-01-01T13:04:00+08:00", "iqama": null, "observance": "ordinary"},
          {"day": "2026-01-01", "kind": "asr", "time": "2026-01-01T16:27:00+08:00", "iqama": null, "observance": "ordinary"},
          {"day": "2026-01-01", "kind": "maghrib", "time": "2026-01-01T19:06:00+08:00", "iqama": null, "observance": "ordinary"},
          {"day": "2026-01-01", "kind": "isha", "time": "2026-01-01T20:20:00+08:00", "iqama": null, "observance": "ordinary"},
          {"day": "2027-02-04", "kind": "fajr", "time": "2027-02-04T05:40:00+08:00", "iqama": null, "observance": "ordinary"},
          {"day": "2027-02-04", "kind": "sunrise", "time": "2027-02-04T07:02:00+08:00", "iqama": null, "observance": "ordinary"},
          {"day": "2027-02-04", "kind": "dhuhr", "time": "2027-02-04T13:04:00+08:00", "iqama": null, "observance": "ordinary"},
          {"day": "2027-02-04", "kind": "asr", "time": "2027-02-04T16:27:00+08:00", "iqama": null, "observance": "ordinary"},
          {"day": "2027-02-04", "kind": "maghrib", "time": "2027-02-04T19:06:00+08:00", "iqama": null, "observance": "ordinary"},
          {"day": "2027-02-04", "kind": "isha", "time": "2027-02-04T20:20:00+08:00", "iqama": null, "observance": "ordinary"}
        ],
        "coverage": {"requested": ["2026-01-01T12:00:00+08:00", "2027-02-05T00:00:00+08:00"]}
      }
    },
    {
