            {"day": "2026-10-16", "times": {"fajr": "05:40", "sunrise": "07:02", "dhuhr": "13:04", "asr": "16:27", "maghrib": "19:06", "isha": "20:20"}}
          ]
        },
        "query": {"type": "state", "at": "2026-10-14T13:04:00+08:00", "through": "2026-10-14T12:00:00+08:00"}
