      "description": "state(at: 2026-01-01 21:00, through: 2028-01-01) clamps its bound to 2027-02-05 00:00 (coverage.requested). The missing days in between keep 2027-02-04's Fajr from being next.",
      "provenance": "RFC 0001 §4.10; §4.7",
      "input": {
        "location": {"latitude": 1.35, "longitude": 103.82, "timeZone": "Asia/Singapore"},
        "source": {
          "expectedKinds": ["fajr", "sunrise", "dhuhr", "asr", "maghrib", "isha"],
          "rows": [
            {"day": "2026-01-01", "times": {"fajr": "05:40", "sunrise": "07:02", "dhuhr": "13:04", "asr": "16:27", "maghrib": "19:06", "isha": "20:20"}},
