{
  "schemaVersion": 1,
  "description": "Wall-time resolution (normal days, spring-forward and fall-back days with each policy, for prayer times, published iqama and IqamaRules .at), publisher instants, and CivilDay.start in zones whose clock change moves midnight.",
  "vectors": [
    {
      "id": "state.walltime.normal-day",
      "description": "A complete row on an ordinary day resolves every wall time once, in the location's zone (EST).",
      "provenance": "RFC 0001 §4.2 (one candidate), §4.4 prayerDay steps 4-8",
      "input": {
        "location": {"latitude": 40.71, "longitude": -74.01, "timeZone": "America/New_York"},
        "source": {
          "expectedKinds": ["fajr", "sunrise", "dhuhr", "asr", "maghrib", "isha"],
          "rows": [
            {"day": "2026-03-05", "times": {"fajr": "05:23", "sunrise": "06:25", "dhuhr": "12:09", "asr": "15:16", "maghrib": "17:53", "isha": "19:11"}}
          ]
        },
        "query": {"type": "day", "day": "2026-03-05"}
      },
      "expected": {
        "availability": "available",
        "coverage": "complete",
        "isFriday": false,
        "events": [
          {"day": "2026-03-05", "kind": "fajr", "time": "2026-03-05T05:23:00-05:00", "iqama": null, "observance": "ordinary"},
          {"day": "2026-03-05", "kind": "sunrise", "time": "2026-03-05T06:25:00-05:00", "iqama": null, "observance": "ordinary"},
          {"day": "2026-03-05", "kind": "dhuhr", "time": "2026-03-05T12:09:00-05:00", "iqama": null, "observance": "ordinary"},
          {"day": "2026-03-05", "kind": "asr", "time": "2026-03-05T15:16:00-05:00", "iqama": null, "observance": "ordinary"},
          {"day": "2026-03-05", "kind": "maghrib", "time": "2026-03-05T17:53:00-05:00", "iqama": null, "observance": "ordinary"},
          {"day": "2026-03-05", "kind": "isha", "time": "2026-03-05T19:11:00-05:00", "iqama": null, "observance": "ordinary"}
        ]
      }
    },
    {
      "id": "state.walltime.spring-forward.reject",
      "description": "Spring forward (America/New_York, 02:00 EST -> 03:00 EDT): Fajr published at 02:30 doesn't exist; the default policy rejects it, so Fajr is missing with reason unresolvedWallTime.",
      "provenance": "RFC 0001 §4.2 'No candidate'; proposal §7.1 'Wall times require a resolution policy'",
      "input": {
        "location": {"latitude": 40.71, "longitude": -74.01, "timeZone": "America/New_York"},
        "source": {
          "expectedKinds": ["fajr", "sunrise", "dhuhr", "asr", "maghrib", "isha"],
          "rows": [
            {"day": "2026-03-08", "times": {"fajr": "02:30", "sunrise": "07:20", "dhuhr": "13:08", "asr": "16:18", "maghrib": "18:56", "isha": "20:14"}}
          ]
        },
        "query": {"type": "day", "day": "2026-03-08"}
      },
      "expected": {
        "availability": "available",
        "coverage": {"partial": {"fajr": "unresolvedWallTime"}},
        "isFriday": false,
        "events": [
          {"day": "2026-03-08", "kind": "sunrise", "time": "2026-03-08T07:20:00-04:00", "iqama": null, "observance": "ordinary"},
          {"day": "2026-03-08", "kind": "dhuhr", "time": "2026-03-08T13:08:00-04:00", "iqama": null, "observance": "ordinary"},
