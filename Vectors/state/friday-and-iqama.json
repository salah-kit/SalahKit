{
  "schemaVersion": 1,
  "description": "Friday as a date fact versus declared Jumu'ah, Jumu'ah iqama rules, published iqama precedence, and iqama rule edge cases including clock changes.",
  "vectors": [
    {
      "id": "state.friday.declared-jumuah",
      "description": "A Friday row that declares Dhuhr as Jumu'ah gives the Dhuhr event observance jumuah; isFriday is true.",
      "provenance": "RFC 0001 §4.4 step 7, §4.3 rule 11 (.jumuah only when the source declares it)",
      "input": {
        "location": {"latitude": 55.95, "longitude": -3.19, "timeZone": "Europe/London"},
        "source": {
          "expectedKinds": ["fajr", "sunrise", "dhuhr", "asr", "maghrib", "isha"],
          "rows": [
            {"day": "2026-10-16", "times": {"fajr": "05:31", "sunrise": "07:24", "dhuhr": "12:52", "asr": "15:37", "maghrib": "18:08", "isha": "19:41"}, "observances": {"dhuhr": "jumuah"}}
          ]
        },
        "query": {"type": "day", "day": "2026-10-16"}
      },
      "expected": {
        "availability": "available",
        "coverage": "complete",
        "isFriday": true,
        "events": [
          {"day": "2026-10-16", "kind": "fajr", "time": "2026-10-16T05:31:00+01:00", "iqama": null, "observance": "ordinary"},
          {"day": "2026-10-16", "kind": "sunrise", "time": "2026-10-16T07:24:00+01:00", "iqama": null, "observance": "ordinary"},
