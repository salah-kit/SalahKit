{
  "schemaVersion": 1,
  "description": "Every failure of RFC 0002 §4.5: invalid coordinates and parameters, unsupported years, an invalid date, a date the zone skips, a day with nothing left, and a kind outside the owning span.",
  "vectors": [
    {
      "id": "calculation.failures.day.latitude-95",
      "description": "Latitude 95: SalahTimes rejects the coordinates, so every day is unavailable with invalidData.",
      "provenance": "RFC 0002 §4.2 step 1-2, §4.3 steps 1-3, §4.5 (invalid coordinates); SalahTimes' algorithm section 2",
      "input": {
        "location": {"latitude": 95, "longitude": 39.8262, "timeZone": "Asia/Riyadh"},
        "settings": {
          "parameters": {
            "fajr": {"angle": 18.5},
            "isha": {"minutesAfterMaghrib": 90},
            "maghrib": "sunset",
            "madhab": "shafi",
            "highLatitudeRule": "recommended",
            "nightSpan": "sunsetToFajr",
            "rounding": "nearest"
          }
        },
        "query": {"type": "day", "day": "2026-10-13"}
      },
      "expected": {"availability": "unavailable", "reason": "invalidData"}
    },
