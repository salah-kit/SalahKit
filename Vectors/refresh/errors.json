          ]
        },
        "query": {"type": "refresh", "from": "2026-10-14T12:00:00+08:00", "through": "2026-10-14T12:00:00+08:00", "strategy": "stateChanges"}
      },
      "expected": {"error": "nonPositiveHorizon"}
    },
