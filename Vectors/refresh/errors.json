    {
      "id": "refresh.error.non-positive-horizon.equal",
      "description": "The end equals the start.",
      "provenance": "RFC 0001 §3 RefreshPlanError, §4.8 Errors",
      "input": {
        "location": {"latitude": 1.35, "longitude": 103.82, "timeZone": "Asia/Singapore"},
        "source": {
          "expectedKinds": ["fajr", "sunrise", "dhuhr", "asr", "maghrib", "isha"],
          "rows": [
            {"day": "2026-10-12", "times": {"fajr": "05:40", "sunrise": "07:02", "dhuhr": "13:04", "asr": "16:27", "maghrib": "19:06", "isha": "20:20"}},
            {"day": "2026-10-13", "times": {"fajr": "05:40", "sunrise": "07:02", "dhuhr": "13:04", "asr": "16:27", "maghrib": "19:06", "isha": "20:20"}},
            {"day": "2026-10-14", "times": {"fajr": "05:40", "sunrise": "07:02", "dhuhr": "13:04", "asr": "16:27", "maghrib": "19:06", "isha": "20:20"}},
